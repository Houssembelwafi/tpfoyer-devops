<?xml version="1.0" encoding="UTF-8"?>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan" enabled="true">
    <hashTree>
        <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
            <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
            <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControllerGui" testclass="LoopController" enabled="true">
                <boolProp name="LoopController.continuous" value="false"/>
                <intProp name="LoopController.loops" value="1"/>
            </elementProp>
            <intProp name="ThreadGroup.num_threads" value="10"/> <!-- Number of threads (users) -->
            <intProp name="ThreadGroup.ramp_time" value="1"/> <!-- Ramp-up time in seconds -->
            <longProp name="ThreadGroup.start_time" />
            <longProp name="ThreadGroup.end_time" />
            <boolProp name="ThreadGroup.scheduler" value="false"/>
            <elementProp name="ThreadGroup.timer" elementType="ConstantTimer" guiclass="ConstantTimerGui" testclass="ConstantTimer" enabled="true">
                <intProp name="ConstantTimer.delay" value="1000"/> <!-- Delay between requests (ms) -->
            </elementProp>
            <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /retrieve-all-blocs" enabled="true">
                    <stringProp name="HTTPSampler.domain">localhost</stringProp> <!-- Server Domain -->
                    <stringProp name="HTTPSampler.port">8089</stringProp> <!-- Server Port -->
                    <stringProp name="HTTPSampler.protocol">http</stringProp> <!-- Protocol -->
                    <stringProp name="HTTPSampler.path">/bloc/retrieve-all-blocs</stringProp> <!-- Path -->
                    <stringProp name="HTTPSampler.method">GET</stringProp> <!-- HTTP Method -->
                    <boolProp name="HTTPSampler.follow_redirects" value="true"/>
                    <boolProp name="HTTPSampler.auto_redirects" value="false"/>
                    <boolProp name="HTTPSampler.use_keepalive" value="true"/>
                    <boolProp name="HTTPSampler.do_multipart" value="false"/>
                    <boolProp name="HTTPSampler.monitor" value="false"/>
                    <stringProp name="HTTPSampler.embedded_url_re" />
                    <hashTree/>
                </HTTPSamplerProxy>
                <hashTree>
                    <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
                        <stringProp name="filename" />
                    </ResultCollector>
                    <hashTree/>
                </hashTree>
            </hashTree>
        </ThreadGroup>
    </hashTree>
</TestPlan>
